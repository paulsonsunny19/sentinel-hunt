@description('Log Analytics workspace name (Sentinel workspace)') param workspaceName string @description('Severity for the scheduled analytics rules derived from these hunts') @allowed(['Low', 'Medium', 'High']) param defaultSeverity string = 'Medium' @description('Enable analytics rules in addition to saved hunting queries') param deployAsAnalyticsRules bool = false resource workspace 'Microsoft.OperationalInsights/workspaces@2023-09-01' existing = { name: workspaceName } var hunts = [ { name: 'lsass-credential-dumping' displayName: 'LSASS Memory Access (Credential Dumping)' tactics: 'CredentialAccess' technique: 'T1003.001' query: loadTextContent('../hunts/01-lsass-credential-dumping.kql') } { name: 'registry-hive-dumping' displayName: 'SAM/SECURITY/SYSTEM Registry Hive Dumping' tactics: 'CredentialAccess' technique: 'T1003.002' query: loadTextContent('../hunts/02-registry-hive-dumping.kql') } { name: 'browser-credential-access' displayName: 'Browser Credential Store Access' tactics: 'CredentialAccess' technique: 'T1555.003' query: loadTextContent('../hunts/03-browser-credential-access.kql') } { name: 'credential-dumping-tools' displayName: 'Known Credential Dumping Tool Signatures' tactics: 'CredentialAccess' technique: 'T1003' query: loadTextContent('../hunts/04-credential-dumping-tools.kql') } ] resource savedSearches 'Microsoft.OperationalInsights/workspaces/savedSearches@2023-09-01' = [for hunt in hunts: { parent: workspace name: 'CredAccessHunt-${hunt.name}' properties: { category: 'Hunting Queries' displayName: hunt.displayName query: hunt.query tags: [ { name: 'Tactics', value: hunt.tactics } { name: 'Technique', value: hunt.technique } ] } }] output deployedHunts array = [for hunt in hunts: hunt.displayName]
