// Hunt: LSASS Memory Access (Credential Dumping)
// Tactic: Credential Access | Technique: T1003.001
DeviceProcessEvents
| where FileName in~ ("procdump.exe", "procdump64.exe", "rundll32.exe", "taskmgr.exe", "werfault.exe")
| where ProcessCommandLine has_any ("lsass", "comsvcs.dll", "MiniDump")
| extend SuspiciousReason = case(
    ProcessCommandLine has "comsvcs.dll", "comsvcs.dll MiniDump technique",
    FileName in~ ("procdump.exe", "procdump64.exe"), "Sysinternals procdump against LSASS",
    "Generic LSASS access pattern"
  )
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, SuspiciousReason, InitiatingProcessFileName, InitiatingProcessAccountName
| order by TimeGenerated desc
